{
  "name": "eupho",
  "version": "0.1.0",
  "private": true,
  "description": "A GitHub-native control plane for swappable coding agents.",
  "type": "module",
  "bin": {
    "eupho": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm test",
    "start": "node --enable-source-maps dist/src/cli.js"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "5.9.3"
  }
}
